# ginblog 配置文件示例
# 复制本文件为 ginblog.yaml 后按需修改
# 加载路径：./ginblog.yaml 或 ./config/ginblog.yaml

server:
  # 服务名称
  server_name: ginblog
  # 服务监听端口
  port: 8080
  # 读取超时（秒）
  read_timeout: 15
  # 写入超时（秒）
  write_timeout: 15
  # 空闲连接超时（秒）
  idle_timeout: 60
  # 服务模式
  server_mode: debug

logger:
  # 日志等级：debug、warn、error、info
  level: debug
  # 日志文件夹
  log_dir: ./logs
  # 日志文件名
  log_file: ginblog.log
  # 单个日志文件最大体积（MB）
  max_size: 100
  # 旧日志文件最多保留时间（天）
  max_age: 7
  # 最多保留几个日志文件
  max_backups: 7
  # 是否压缩旧日志文件
  compress: true

database:
  # SQLite 数据库文件路径
  file: ./data/ginblog.db

redis:
  # Redis 服务地址
  addr: 127.0.0.1:6379
  # 访问密码，无密码时留空
  password: ""
  # 逻辑库编号
  db: 0
  # 连接超时 —— 必须带单位（ns/µs/ms/s/m/h）
  # 注意：写 3 表示 3 纳秒，不是 3 秒
  dial_timeout: 3s
  # 读超时
  read_timeout: 3s
  # 写超时
  write_timeout: 3s
  # 连接池大小；设为 0 时 go-redis 取 10 * GOMAXPROCS
  pool_size: 10

auth:
  # 登录态 cookie 名称
  cookie_name: ginblog_sid
  # 登录态有效期（小时）；cookie maxAge 与 session TTL 同源于此值
  expire_hours: 168
  # 仅通过 HTTPS 下发 cookie；本地开发保持 false
  secure: false
  # session key 前缀，最终 key 形如 ginblog:session:{sha256(token)}
  # 与其他业务共用同一个 Redis 库时靠它隔离
  session_prefix: "ginblog:"
